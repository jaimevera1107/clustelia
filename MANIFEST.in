# Only package sources and accompanying human-readable documentation.
# Benchmark outputs and pickle snapshots remain in the GitHub repository,
# not in the wheel or source distribution uploaded to PyPI.
include LICENSE README.md CHANGELOG.md CONTRIBUTING.md
recursive-include docs *.md
recursive-include examples *.py
include src/clustelia/py.typed
prune docs/benchmark
prune docs/equivalence
prune tools
prune tests
global-exclude *.py[cod] __pycache__/* *.pkl
